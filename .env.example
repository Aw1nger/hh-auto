# ============================================================
#  hh-autoresponder (Bun + TypeScript)
#  Скопируй в .env и заполни. Обязательны только TG_BOT_TOKEN,
#  TG_ADMIN_CHAT_ID. HH_LOGIN/HH_PASSWORD нужны для входа по паролю,
#  но можно войти по коду через /login или `bun run login`.
# ============================================================

# ── Telegram (панель управления) ──────────────────────────
# Токен бота из @BotFather
TG_BOT_TOKEN=
# Твой числовой id из @userinfobot
TG_ADMIN_CHAT_ID=
# Прокси для Telegram, если из страны с блокировкой (опц.)
# Bun: socks5://user:pass@host:port или http://host:port
TG_PROXY=
# Свой Bot API server (опц.), например http://127.0.0.1:8081
TG_API_SERVER=

# ── hh.ru ─────────────────────────────────────────────────
# Логин/пароль нужны только для входа по паролю в Playwright.
# Если входишь по коду (/login) — можно оставить пустыми.
HH_LOGIN=
HH_PASSWORD=
# id резюме. Оставь пустым — бот возьмёт первое резюме из аккаунта.
HH_RESUME_ID=
# User-Agent для API hh.ru. Пример — iPhone 16 / iOS 18.6 Safari.
# Если оставить пустым, бот сгенерирует официальный Android UA.
HH_USER_AGENT="Mozilla/5.0 (iPhone; CPU iPhone OS 18_6 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/18.6 Mobile/15E148 Safari/604.1"
# Резервный UA: используется, если hh просит капчу на HH_USER_AGENT.
# Формат официального Android-приложения работает стабильнее для API.
HH_USER_AGENT_FALLBACK="ru.hh.android/7.131.23456, Device: QWERTY1234, Android OS: 14 (UUID: 423e4567-e89b-12d3-a456-426614174000)"

# ── Профиль и цель ────────────────────────────────────────
DESIRED_POSITION=Performance-маркетолог
DESIRED_SALARY_MIN=150000
DESIRED_SALARY_MAX=400000

# ── Поисковые запросы (через запятую) ─────────────────────
SEARCH_QUERIES_RAW=performance маркетолог, интернет-маркетолог, директолог
# Сколько страниц выдачи и карточек на страницу парсить
SEARCH_PAGES=3
SEARCH_PER_PAGE=50

# ── Скоринг вакансий (всё через запятую) ──────────────────
# Хотя бы одно слово в заголовке → вакансия подходит
TARGET_KEYWORDS_RAW=маркетолог, marketing, performance, трафик, seo, smm, директолог, таргетолог, ppc, digital
# Слово в заголовке → вакансия отсеивается
NEGATIVE_KEYWORDS_RAW=junior, стажёр, стажер, intern, ассистент, помощник, продавец, менеджер по продажам
# Каждое совпадение в тексте даёт бонус к score
STACK_KEYWORDS_RAW=performance, cpa, roi, drr, seo, smm, таргет, контекст, директ, google ads, аналитика, воронк, unit
# Вакансии с указанной ЗП ниже порога отсеиваются
SALARY_FLOOR=100000

# ── Сопроводительное письмо (одно на всех) ────────────────
# Можно использовать {vacancy} и {company}
COVER_LETTER=Добрый день! Заинтересовала ваша вакансия, у меня релевантный опыт, буду рад пообщаться.

# ── Темп / антибан ────────────────────────────────────────
CHECK_INTERVAL_SEC=300
BROWSER_HEADLESS=true
# Канал браузера для Playwright (опц.): chrome, msedge. Пусто = Chromium.
BROWSER_CHANNEL=
PROXY_URL=
# Пауза между откликами, сек (низ/верх).
APPLY_DELAY_MIN=40
APPLY_DELAY_MAX=68
# Дневной лимит. 200 — потолок самого hh.
MAX_APPLIES_PER_DAY_HH=200
# Порог score днём/ночью
APPLY_MIN_SCORE_DAY=1
APPLY_MIN_SCORE_NIGHT=50
# Дневное окно (МСК)
DAY_START_HOUR=9
DAY_END_HOUR=22

# ── Капча hh.ru → Telegram ────────────────────────────────
# Главная фича: картинка капчи приходит в Telegram, ответ — текстом.
CAPTCHA_ENABLED=true
# Сколько ждать ответ (сек)
CAPTCHA_TIMEOUT_SEC=300
# Сколько раз показывать новую капчу при неверном ответе
CAPTCHA_MAX_ATTEMPTS=3
# Язык картинки: RU или EN
CAPTCHA_LANG=RU
# Пауза перед отправкой ответа hh (сек), чтобы не выглядеть ботом
CAPTCHA_SUBMIT_DELAY_SEC=10
# Пауза между запросами капчи (сек)
CAPTCHA_COOLDOWN_SEC=30
# Где хранить cookies страницы капчи
CAPTCHA_COOKIE_PATH=data/captcha_cookies.json

# ── База и файлы ──────────────────────────────────────────
DATA_DIR=data
DATABASE_PATH=data/jobhunter.db
HH_TOKEN_PATH=data/hh_oauth_token.json
HH_STATE_PATH=data/browser_sessions/hh_state.json
SCHEDULER_STATE_PATH=data/scheduler_state.json

# ── Уведомления (тихие часы, МСК) ─────────────────────────
NOTIFY_HOUR_START=9
NOTIFY_HOUR_END=22

# ── Прочее ────────────────────────────────────────────────
LOG_LEVEL=info
# DRY_RUN=true — только искать и логировать, не откликаться
DRY_RUN=false
