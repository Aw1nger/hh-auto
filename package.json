{
  "name": "hh-autoresponder",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram-бот автооткликов на hh.ru на Bun + TypeScript",
  "license": "MIT",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "login": "bun run src/scripts/login.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "grammy": "^1.34.0",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
